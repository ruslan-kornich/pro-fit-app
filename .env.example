JWT_SECRET=your-super-secret-jwt-key-change-in-production
OPENAI_API_KEY=sk-your-openai-api-key-here
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/profit

# Object storage for meal photos. Leave S3_BUCKET empty to store them in
# UPLOAD_DIR on the local filesystem instead.
S3_BUCKET=
S3_ENDPOINT_URL=https://s3.runsite.app
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=eu-central
S3_ADDRESSING_STYLE=path
# Public bucket: stable cacheable URLs. Leave empty for presigned URLs.
S3_PUBLIC_BASE_URL=
