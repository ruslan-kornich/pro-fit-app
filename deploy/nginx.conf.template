# Rendered by deploy/entrypoint.sh (envsubst) into /etc/nginx/conf.d/.

upstream backend_upstream {
    server 127.0.0.1:${BACKEND_PORT};
    keepalive 16;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Platforms terminate TLS in front of the container; fall back to the local
# scheme when no forwarded header is present.
map $http_x_forwarded_proto $forwarded_scheme {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen ${PORT} default_server;
    server_name _;

    root /srv/www;
    index index.html;

    client_max_body_size ${UPLOAD_MAX_SIZE_MB}m;
    server_tokens off;

    # TLS and the public port live in the platform's proxy, so redirects must
    # stay relative instead of pointing back at this container's port.
    absolute_redirect off;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json
               application/manifest+json application/xml image/svg+xml font/woff2;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Photo analysis calls OpenAI synchronously and can take a while.
    proxy_connect_timeout 15s;
    proxy_send_timeout 180s;
    proxy_read_timeout 180s;

    # FastAPI already mounts its routers under /api, so the prefix is kept.
    location /api/ {
        proxy_pass http://backend_upstream;
    }

    # Uploaded meal photos are served by FastAPI's StaticFiles mount.
    location /uploads/ {
        proxy_pass http://backend_upstream;
        add_header Cache-Control "public, max-age=2592000";
    }

    location = /health {
        access_log off;
        proxy_pass http://backend_upstream;
    }

    # Service worker must never be cached, otherwise clients pin an old build.
    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Service-Worker-Allowed "/";
    }

    location ~* ^/workbox-.*\.js$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location = /manifest.webmanifest {
        types { }
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    # Vite emits content-hashed filenames here.
    location /assets/ {
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
